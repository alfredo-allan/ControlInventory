# Copie pra client/.env.local e preencha (o .local nunca vai pro git).

# URL base da API (backend/). Em dev local, normalmente http://127.0.0.1:5050
# — confira a porta que você usou em `python -m flask run --port ...`.
VITE_API_URL=http://127.0.0.1:5050

# Não tem mais nenhuma credencial aqui — a partir de 2026-10-13 o login é
# individual, por operador (ver client/src/pages/login.tsx), direto na tela,
# sem senha nenhuma guardada no bundle do frontend. O usuário de serviço
# "app-sync" criado antes disso (login automático) não é mais usado pelo
# app; pode ser mantido como mais um operador comum ou apagado, como preferir.
